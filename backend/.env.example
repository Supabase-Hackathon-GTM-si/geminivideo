# Copy to backend/.env and fill in. NEVER commit backend/.env.
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-latest
CHUNK_SECONDS=10
CONFIDENCE_THRESHOLD=0.6
COOLDOWN_SECONDS=30

# Campaign
SPONSOR_BRAND=Gatorade
COMPETITOR_BRANDS=Prime,Powerade,BodyArmor,Liquid IV,Red Bull,Monster,Celsius,Ghost,G Fuel,Electrolit

# Stricter second pass on tip candidates
GEMINI_VERIFY_MODEL=gemini-pro-latest
VERIFY_ENABLED=true

# Which on-screen subjects can earn tips: real_person, animated_character, video_playback
ALLOWED_SUBJECT_TYPES=real_person

# Sponsor screen-time bonus (cents per prominence-weighted second, per clip)
EXPOSURE_CENTS_PER_SECOND=5
MIN_EXPOSURE_SECONDS=2

# Alcohol / vaping / NSFW / slurs / gambling in a clip blocks its tips
SAFETY_BLOCKS_TIPS=true

# Anti-gaming: max tips for the same category+brand per window of stream time
REPEAT_LIMIT=3
REPEAT_WINDOW_SECONDS=600

# Drop queued clips beyond this so analysis stays near live
MAX_BACKLOG=3

# Bounding boxes around the product on evidence thumbnails
BOXES_ENABLED=true

# Live chat (Twitch chat is read anonymously; chat around a moment scores audience reaction)
TWITCH_CHAT=true
CHAT_CONTEXT_SECONDS=5
CHAT_REACTION_SECONDS=12

# Demo-mode thank-you alerts: Gemini writes the message, speaks it, and makes a card
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Puck
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ALERT_CARDS=true

# Teammates' endpoint (Supabase edge function / Stripe tipping service). Leave empty to disable.
EVENT_WEBHOOK_URL=
