# Copy to backend/.env and fill in. NEVER commit backend/.env.
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-latest
CHUNK_SECONDS=10
CONFIDENCE_THRESHOLD=0.6
COOLDOWN_SECONDS=30

# Teammates' endpoint (Supabase edge function / Stripe tipping service). Leave empty to disable.
EVENT_WEBHOOK_URL=
